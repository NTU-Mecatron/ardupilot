# Speed (m/s) to throttle (-1.0 to 1.0) PID
SPD_CTRL_P       0.10
SPD_CTRL_I       0.01
SPD_CTRL_D       0.00
SPD_CTRL_IMAX    0.15
SPD_CTRL_FF      0.10
SPD_CTRL_D_FF    0.00
SPD_CTRL_FLTD    0.00
SPD_CTRL_FLTE    0.00
SPD_CTRL_FLTT    0.00
SPD_CTRL_NEF     0.0
SPD_CTRL_NTF     0.0
SPD_CTRL_PDMX    0.00
SPD_CTRL_SMAX    0.00

# Speed (m/s) to compared again when speed scaling for roll, pitch, yaw controllers
# Changing this param will affect all PID params for the above controllers
# Should be set at the most commonly used speed for the vehicle
SCALING_SPEED    1.50