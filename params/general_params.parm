# ===================== Waypoint params ===================== #
# Default radius for loitering around a wp
WP_LOITER_RAD    -30

# Default radius to be considered to have reached a wp
WP_RADIUS        30

# ===================== Takeoff params  ===================== #
# Takeoff taildrag params
# Used for when vehicle is on surface and taking off, we want to force the elevator up so that vehicle can maintain upward pitch and thruster in water
# Forcing elevator is useful because at low speed, pid control will not be accurate
# When forward speed is above TKOFF_TDRAG_SPD1, auto transition from elevator forcing to Pitch_PID to achieve target pitch of TKOFF_GND_PITCH
# TKOFF_GND_PITCH should be positive so that vehicle will continue to pitch up until reaching TKOFF_SPEED
TKOFF_TDRAG_ELEV 30
TKOFF_TDRAG_SPD1 1.000000
TKOFF_GND_PITCH  5.000000

# Takeoff alt, pitch and speed are default values if the values given in mission file is invalid/empty
# When forward speed has reached TKOFF_SPEED, command Pitch_PID to achieve TKOFF_PITCH or the pitch given in mission file (if valid ie. negative)
TKOFF_ALT        -3.000000
TKOFF_PITCH      -15.000000
TKOFF_SPEED      3.000000
# If after this time and still has not reached takeoff speed, abort
TKOFF_TIMEOUT    10

# ===================== Speed params ========================= #
# Speed cruise should be set to same as scaling speed
# Speed max and min are limits for speed scaling, and for operation in general
SPEED_CRUISE     3.00
SPEED_MAX        8.00
SPEED_MIN        1.00

# ===================== Miscellaneous ========================= #
# Compulsory bidirectional thruster setup
USE_REV_THRUST  1
THR_MIN         -100
THR_MAX         100

# Disable rc thr failsafe as most of the time we do not have rc
THR_FAILSAFE     0

# Control tuning and navigation tuning only
LOG_BITMASK      8241
LOG_FILE_DSRMROT 1

# Disable stick mixing
STICK_MIXING     0

# ============ CRITICAL, CONSEQUENTIAL PARAMS ================= #
# Changing any of these params will affect all other PID params for very self-explanatory reasons
# This should only be done once before all tuning start, with careful consideration!

# Speed (m/s) to compared again when speed scaling for roll, pitch, yaw controllers
# Should be set at the most commonly used speed for the vehicle
SCALING_SPEED    3.00

# Changing any of these fins configs requires reboot to take effect
# Fins mixing config (0-plus, 1-X, 2-plus-w-canards, 3-x-w-canards)
FINS_CONFIG      3
# Roll effectiveness factor in control effectiveness matrix. Should be equal to r/x where r is the body radius and x is distance from CG to fin along the forward axis.
FINS_RLL_FT      0.330000
# Pitch effectiveness factor of canards in matrix. Must be positive number and smaller than the pitch factor of back fins (which is either 1 or 0.707).
FINS_C_PIT_FT    0.300000
# Roll effectiveness factor of canards in matrix. Can be set to zero to disable roll contribution from canards.
FINS_C_RLL_FT    0.000000

# ============================================================= #