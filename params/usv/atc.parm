# PID paramaters for roll pitch yaw control
# USV: roll and pitch control is disabled (all gains zeroed) since the vessel tilts with the waves; only yaw is actively controlled

# Roll/pitch params zeroed for USV
# ATC_ANG_RLL_P, ATC_ANG_PIT_P - disables desired angle-to-rate calculation
# ATC_RAT_RLL_P, ATC_RAT_PIT_P - proportional gain
# ATC_RAT_RLL_I, ATC_RAT_PIT_I - eliminates integral windup from wave tilt
# ATC_RAT_RLL_D, ATC_RAT_PIT_D - derivative gain
# ATC_RAT_RLL_FF, ATC_RAT_PIT_FF - feed-forward gain
# ATC_RAT_RLL_IMAX, ATC_RAT_PIT_IMAX - zeroes max integrator limit

# Some non-default params
# ATC_ANG_YAW_P (default 6.00, range 0.00-6.00)
# ATC_RAT_YAW_I (default 0.018, range 0.00-0.05)
ATC_RAT_PIT_D    0.0
ATC_RAT_PIT_D_FF 0.0
ATC_RAT_PIT_FF   0.0
ATC_RAT_PIT_FLTD 30.0
ATC_RAT_PIT_FLTE 0.0
ATC_RAT_PIT_FLTT 30.0
ATC_RAT_PIT_I    0.0
ATC_RAT_PIT_IMAX 0.0
ATC_RAT_PIT_NEF  0.0
ATC_RAT_PIT_NTF  0.0
ATC_RAT_PIT_P    0.0
ATC_RAT_PIT_PDMX 0.0
ATC_RAT_PIT_SMAX 0.0

ATC_RAT_RLL_D    0.0
ATC_RAT_RLL_D_FF 0.0
ATC_RAT_RLL_FF   0.0
ATC_RAT_RLL_FLTD 30.0
ATC_RAT_RLL_FLTE 0.0
ATC_RAT_RLL_FLTT 30.0
ATC_RAT_RLL_I    0.0
ATC_RAT_RLL_IMAX 0.0
ATC_RAT_RLL_NEF  0.0
ATC_RAT_RLL_NTF  0.0
ATC_RAT_RLL_P    0.0
ATC_RAT_RLL_PDMX 0.0
ATC_RAT_RLL_SMAX 0.0

# Some non-default params
# ATC_RAT_YAW_D (default 0.00, range 0.00-0.02)
# ATC_RAT_YAW_P (default 0.18, range 0.00-0.50)
ATC_RAT_YAW_D    0.01
ATC_RAT_YAW_D_FF 0.0
ATC_RAT_YAW_FF   0.0
ATC_RAT_YAW_FLTD 5.0
ATC_RAT_YAW_FLTE 0.0
ATC_RAT_YAW_FLTT 5.0
ATC_RAT_YAW_I    0.0
ATC_RAT_YAW_IMAX 0.222
ATC_RAT_YAW_NEF  0.0
ATC_RAT_YAW_NTF  0.0
ATC_RAT_YAW_P    0.25
ATC_RAT_YAW_PDMX 0.0
ATC_RAT_YAW_SMAX 0.0

ATC_ANG_PIT_P    0.0
ATC_ANG_RLL_P    0.0
ATC_ANG_YAW_P    4.0