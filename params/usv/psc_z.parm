# PID paramaters for vertical (depth) control
# USV: Z-axis position, velocity and acceleration controllers are disabled (gains zeroed) since the vessel stays on the surface

# Params zeroed for USV
# PSC_POSZ_P - Z position P gain
# PSC_VELZ_P - Z velocity P gain
# PSC_ACCZ_P - Z acceleration P gain
# PSC_ACCZ_I - Z acceleration I gain
# PSC_ACCZ_IMAX - Z acceleration max integrator limit

# There are some non-default params
# SURFACE_DEPTH (default -10.0, unit cm)
# PSC_VELZ_D (default 0.0, range 0.0-1.0)
# PSC_VELZ_FF (default 0.0, range 0.0-1.0)

PSC_ACCZ_D	    0.0
PSC_ACCZ_D_FF	  0.0
PSC_ACCZ_FF	    0.0
PSC_ACCZ_FLTD	  0.0
PSC_ACCZ_FLTE	  20.0
PSC_ACCZ_FLTT	  0.0
PSC_ACCZ_I	    0.0
PSC_ACCZ_IMAX	  0.0
PSC_ACCZ_NEF	  0
PSC_ACCZ_NTF	  0
PSC_ACCZ_P	    0.0
PSC_ACCZ_PDMX	  0.0
PSC_ACCZ_SMAX	  0.0
PSC_JERK_Z	    50.0

PSC_VELZ_D	    0.75
PSC_VELZ_FF	    0.5
PSC_VELZ_FLTD	  5.0
PSC_VELZ_FLTE	  5.0
PSC_VELZ_I	    0.0
PSC_VELZ_IMAX	  1.0
PSC_VELZ_P	    0.0

PSC_POSZ_P	    0.0
SURFACE_DEPTH   -2.0