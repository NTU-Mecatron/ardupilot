# L1 control params for trajectory tracking (as well as heading hold)
# Output lateral acceleration (m/s2)
NAVL1_DAMPING    0.750000
NAVL1_LIM_BANK   0.000000
NAVL1_PERIOD     15.000000
NAVL1_XTRACK_I   0.020000

# Lat acc cascade down: yaw_rate = deg( lat_acc / speed )
# Yaw rate (deg/s) to rudder steering (deg) PID, auto capped between -45 and 45deg
STEER2SRV_P      1.800000
STEER2SRV_I      0.200000
STEER2SRV_D      0.005000
STEER2SRV_FF     0.000000
STEER2SRV_DRTFCT 10.000000
STEER2SRV_DRTMIN 4500.000000
STEER2SRV_DRTSPD 0.000000
STEER2SRV_IMAX   1500
STEER2SRV_MINSPD 1.000000
STEER2SRV_TCONST 0.750000