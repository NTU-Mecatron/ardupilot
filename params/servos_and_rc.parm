# Compulsory bidirectional thruster setup
USE_REV_THRUST  1
THR_MIN         -100
THR_MAX         100

# Disable rc thr failsafe as most of the time we do not have rc
THR_FAILSAFE     0

# Rudders, top and bottom
SERVO1_FUNCTION 21
SERVO3_FUNCTION 21

# Elevators, right and left
SERVO2_FUNCTION 19
SERVO4_FUNCTION 19

# Throttle
SERVO5_FUNCTION 70

# Servo directions
SERVO1_REVERSED 1
SERVO2_REVERSED 0
SERVO3_REVERSED 0
SERVO4_REVERSED 1

# Servo min
SERVO1_MIN 1000
SERVO2_MIN 1000
SERVO3_MIN 1000
SERVO4_MIN 1000
SERVO5_MIN 1000

# Servo max
SERVO1_MAX 2000
SERVO2_MAX 2000
SERVO3_MAX 2000
SERVO4_MAX 2000
SERVO5_MAX 2000

# Servo trim
SERVO1_TRIM 1500
SERVO2_TRIM 1500
SERVO3_TRIM 1500
SERVO4_TRIM 1500
SERVO5_TRIM 1500

# RC Mapping
RCMAP_ROLL 1
RCMAP_PITCH 2
RCMAP_THROTTLE 3
RCMAP_YAW 4

# RC min
RC1_MIN 1000
RC2_MIN 1000
RC3_MIN 1000
RC4_MIN 1000

# RC max
RC1_MAX 2000
RC2_MAX 2000
RC3_MAX 2000
RC4_MAX 2000

# RC trim
RC1_TRIM 1500
RC2_TRIM 1500
RC3_TRIM 1500
RC4_TRIM 1500

# RC reverse
RC1_REVERSED 0
RC2_REVERSED 0
RC3_REVERSED 0
RC4_REVERSED 0