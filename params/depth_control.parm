# Vehicle pitch limits (positive is pitch up)
PTCH_LIM_MAX_DEG 15.000000
PTCH_LIM_MIN_DEG -20.000000

# PI controller: altitude -> pitch
# BUOYANCY_FF: Pitch down angle (degrees) to counteract buoyancy at typical operating speed (SCALING_SPEED)
ALT_CTRL_P       0.175000
ALT_CTRL_I       0.025000
ALT_CTRL_IMAX    0.175000
ALT_BUOYANCY_FF  5.000000

# P controller: pitch_rate = pitch_error / tconst
# RMAX_UP and RMAX_DOWN is maximum rate (deg/s) for up and down respectively
PTCH2SRV_TCONST  4.0
PTCH2SRV_RMAX_UP 20
PTCH2SRV_RMAX_DN 20
PTCH2SRV_RLL     0.0

# PID controller: Pitch rate -> elevator
# Max elevator limit is hardcoded 45deg, but after fins mapping, the limit for each fin may be different
PTCH_RATE_P      0.30000
PTCH_RATE_I      0.110000
PTCH_RATE_D      0.007265
PTCH_RATE_IMAX   0.666000
PTCH_RATE_FF     0.595723
PTCH_RATE_D_FF   0.000000
PTCH_RATE_FLTD   12.000000
PTCH_RATE_FLTE   0.000000
PTCH_RATE_FLTT   3.000000
PTCH_RATE_NEF    0
PTCH_RATE_NTF    0
PTCH_RATE_PDMX   0.000000
PTCH_RATE_SMAX   150.000000
PTCH_TRIM_DEG    0.000000