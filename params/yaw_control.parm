# L1 control params for trajectory tracking (as well as heading hold)
# Output lateral acceleration (m/s2)

# Period in seconds of L1 tracking loop. This parameter is the primary control for aggressiveness of turns in auto mode. This needs to be larger for less responsive frames. Recommended range for torp AUV: 40-80. Change in increments of 5.
NAVL1_PERIOD     55.000000

# Damping ratio for L1 control. Increase this in increments of 0.05 if you are getting overshoot in path tracking. You should not need a value below 0.7 or above 0.85.
NAVL1_DAMPING    0.7200

# Crosstrack error integrator gain. This gain is applied to the crosstrack error to ensure it converges to zero. Set to zero to disable. Only used in following waypoints, not when loitering or heading hold.
NAVL1_XTRACK_I   0.0200

# Max yaw rate for all control (deg/s)
YAW_MAX_RATE     15

# Lat acc cascade down: yaw_rate = lat_acc / speed
# Yaw rate to rudder PID
YAW_RATE_P       7.000
YAW_RATE_I       0.000
YAW_RATE_D       7.0000
YAW_RATE_IMAX    0.1100
YAW_RATE_FF      0.500

YAW_RATE_D_FF    0.000000
YAW_RATE_FLTD    0.200000
YAW_RATE_FLTE    0.000000
YAW_RATE_FLTT    10.000000
YAW_RATE_NEF     0
YAW_RATE_NTF     0
YAW_RATE_PDMX    0.40000
YAW_RATE_SMAX    150.000000

# Not in used, leave here for consistency
# Heading control is all handled by L1 to compute yaw rate directly
YAW_TCONST       1.00000